{
  "_note": "Every assumption of the system lives here. Nothing in the code refers to a specific grid, place, line ID or report. Replace the numbers with real statistics for your region and operator.",

  "schema": {
    "_how": "Property names tried in order when reading any LineString/MultiLineString GeoJSON. Missing values are derived or left neutral.",
    "segment_id": ["segment_id", "id", "line_id", "name", "osm_id"],
    "voltage_kv": ["voltage_kv", "voltage", "kv"],
    "circuits": ["circuits", "circuit_count"],
    "cables": ["cables", "conductors"],
    "length_km": ["length_km", "length"],
    "from_node": ["from_node", "from", "source"],
    "to_node": ["to_node", "to", "target"],
    "node_id": ["node_id", "id"],
    "node_type": ["node_type", "type", "power"],
    "fault_prob": ["fault_prob", "p_fault", "prior"]
  },

  "scenario": {
    "_how": "How live context is recognised in any scenario file: an event area is a polygon whose kind/label contains one of event_area_words; report areas are polygons tied to a report id.",
    "event_area_words": ["storm", "footprint", "event", "hazard", "warning"],
    "dead_line_words": ["de-energized", "de-energised", "switched off", "out of service", "tripped", "dead", "not live"],
    "default_window_h": 4,
    "event_season": null
  },

  "season_share": {"winter": 0.25, "spring": 0.25, "summer": 0.25, "autumn": 0.25},
  "seasons": {
    "winter": {"wind_from_deg": 245, "wind": 1.6, "ice": 1.4, "vegetation": 1.0, "lightning": 1.0, "heat": 1.0},
    "spring": {"wind_from_deg": 260, "wind": 0.8, "ice": 1.0, "vegetation": 1.3, "lightning": 1.1, "heat": 1.0},
    "summer": {"wind_from_deg": 270, "wind": 0.7, "ice": 1.0, "vegetation": 1.5, "lightning": 1.8, "heat": 1.3},
    "autumn": {"wind_from_deg": 240, "wind": 2.0, "ice": 1.0, "vegetation": 1.4, "lightning": 1.0, "heat": 1.0}
  },
  "line_factors": {
    "_how": "Voltage classes are relative to the grid being analysed: 'low' = below the median voltage of the input, 'high' = the top voltage present.",
    "vegetation_low_voltage": 1.5,
    "vegetation_high_voltage": 0.5,
    "lightning_high_voltage": 1.3,
    "ice_single_circuit": 1.5,
    "single_circuit_max_cables": 4,
    "heat_long_line_km": 5.0,
    "missing_data": 1.1
  },

  "prior": {
    "faults_per_km_in_event_area": 0.010,
    "outside_event_area_factor": 0.2,
    "cell_km": 1.0,
    "dead_line_lr": 1.5
  },
  "reports": {
    "_how": "Likelihood ratio for 'a fault inside this report area', matched by keyword in the report type or description (first match wins). Scaled by confidence: 1 + (LR - 1) * confidence.",
    "lr_by_keyword": [
      ["vegetation", 3.0], ["tree", 3.0], ["branch", 3.0],
      ["protection", 2.5], ["trip", 2.5], ["reclose", 2.5],
      ["warmth", 3.0], ["thermal", 3.0], ["hot", 3.0], ["sound", 2.0],
      ["motion", 3.0], ["gallop", 3.0], ["sag", 3.0],
      ["flash", 1.5], ["spark", 1.5],
      ["weather", 1.0], ["alert", 1.0], ["warning", 1.0]
    ],
    "default_lr": 1.5,
    "confidence_words": [["very low", 0.2], ["low to medium", 0.55], ["medium to high", 0.8], ["low", 0.35], ["medium", 0.7], ["very high", 0.95], ["high", 0.9]],
    "default_confidence": 0.5
  },
  "consequence": {
    "_how": "1 + (max_factor - 1) * voltage position between the lowest and highest voltage in the input; x radial when a substation is fed by this line only.",
    "voltage_max_factor": 3.0,
    "radial_feed": 1.5,
    "dead_line": 1.3,
    "substation_words": ["substation", "station", "umspannwerk"],
    "overrides": {}
  },
  "sensors": {
    "detect_prob": 0.75,
    "lr": {"strong": 8.0, "weak": 2.0, "unclear": 1.0},
    "neighbour_lr": {"strong": 1.5, "weak": 1.2},
    "channels": ["visual", "temperature", "3D position"]
  },
  "limits": {"flight_min": 30, "reserve_min": 6, "cruise_kmh": 54, "inspect_kmh": 20, "charge_h": 3},
  "decision": {
    "p_clear": 0.02,
    "p_repair": 0.8,
    "p_inspect": 0.5,
    "unclear_passes_for_crew": 2,
    "unclear_min_priority": 0.15
  },
  "cost": {"drone_sortie": 0.2, "crew_inspection": 1.0, "repair_crew": 4.0, "outage_hour": 3.0, "crew_eta_h": 1.5}
}
